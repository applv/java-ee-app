<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
  version="3.0">
  <persistence-unit name="wildfly.tutorDB" transaction-type="JTA">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <jta-data-source>java:/tutorDB</jta-data-source>
    <properties>
      <!-- Hibernate specific properties -->
      <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect" />
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.hbm2ddl.auto" value="update"/>
    </properties>
  </persistence-unit>

  <persistence-unit name="postgres.tutorDB" transaction-type="JTA">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <jta-data-source>java:/pg.tutor</jta-data-source>
    <properties>
      <property name="jakarta.persistence.jdbc.driver"   value="org.postgresql.Driver"/>
      <property name="jakarta.persistence.jdbc.url"      value="jdbc:postgresql://172.20.0.3:5432/tutor"/>
      <property name="jakarta.persistence.jdbc.user"     value="applv"/>
      <property name="jakarta.persistence.jdbc.password" value="kk556217"/>

      <property name="javax.persistence.jdbc.driver"   value="org.postgresql.Driver"/>
      <property name="javax.persistence.jdbc.url"      value="jdbc:postgresql://172.20.0.3:5432/tutor"/>
      <property name="javax.persistence.jdbc.user"     value="applv"/>
      <property name="javax.persistence.jdbc.password" value="kk556217"/>

      <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect" />
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.hbm2ddl.auto" value="update"/>
    </properties>
  </persistence-unit>

</persistence>
