<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE struts-config PUBLIC
  "-//Apache Software Foundation//DTD Struts Configuration 1.1//EN"
  "http://jakarta.apache.org/struts/dtds/struts-config_1_1.dtd">

<struts-config>
<!-- =================== Form Bean Definitions ===================-->
<form-beans>
  <form-bean name="logonForm" type="com.example.forms.LogonForm"/>
  <form-bean name="searchForm" type="org.apache.struts.action.DynaActionForm">
    <form-property name="id" type="java.lang.String"/>
    <form-property name="title" type="java.lang.String"/>
  </form-bean>
</form-beans>

<!-- ================= Global Forward Definitions ==================-->
<global-forwards>
  <forward name="welcome" path="/pages/Welcome.jsp"/>
  <forward name="error" path="/pages/Error.jsp"/>
  <forward name="success" path="/pages/Success.jsp"/>
</global-forwards>


<action-mappings>

          <action path="/login"
            type="com.example.actions.LoginAction"
            name="logonForm"
            scope="request"
            input="/pages/Logon.jsp"
            validate="true">
            <forward name="success" path="/pages/MainMenu.jsp"/>
            <forward name="failure" path="/pages/Logon.jsp"/>
          </action>

          <action path="/logout"
            type="com.example.actions.LogoutAction">
            <forward name="success" path="/pages/Logon.jsp"/>
          </action>

          <action path="/search"
            type="com.example.actions.SearchAction"
            name="searchForm"
            scope="request"
            input="/pages/Search.jsp">
            <forward name="results" path="/pages/SearchResults.jsp"/>
          </action>
</action-mappings>

<!-- =================== Controller Definitions ===================-->
<controller processorClass="org.apache.struts.action.RequestProcessor"/>

<!-- =================== Message Resources Definitions ===================-->
<message-resources parameter="com.example.resources.ApplicationResources"/>

</struts-config>